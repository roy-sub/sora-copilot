{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/dronex-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Outfit))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Outfit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconPosition|markBadge|assetBase|full|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconPosition, markBadge, assetBase, full, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|pill|accent|block|invert)$/]",
        "message": "<Button> variant must be one of 'outline' | 'pill' | 'accent' | 'block' | 'invert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:onPrev|onNext|tone|size|spread|style|key|ref|className|style|children)$/]",
        "message": "<CarouselNav> doesn't accept that prop. Declared props: onPrev, onNext, tone, size, spread, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselNav'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:outline|accent|paper|ink)$/]",
        "message": "<CarouselNav> tone must be one of 'outline' | 'accent' | 'paper' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselNav'] > JSXAttribute[name.name='spread'] > Literal[value!=/^(?:space-between|flex-end|flex-start)$/]",
        "message": "<CarouselNav> spread must be one of 'space-between' | 'flex-end' | 'flex-start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tag|title|body|tone|titleSize|media|mediaPosition|footer|children|style|key|ref|className|style|children)$/]",
        "message": "<ContentCard> doesn't accept that prop. Declared props: tag, title, body, tone, titleSize, media, mediaPosition, footer, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|concrete|ink|accent)$/]",
        "message": "<ContentCard> tone must be one of 'paper' | 'concrete' | 'ink' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentCard'] > JSXAttribute[name.name='mediaPosition'] > Literal[value!=/^(?:above|below)$/]",
        "message": "<ContentCard> mediaPosition must be one of 'above' | 'below'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|size|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconBadge> doesn't accept that prop. Declared props: icon, tone, size, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|paper|ink|outline)$/]",
        "message": "<IconBadge> tone must be one of 'accent' | 'paper' | 'ink' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|placeholder|value|onChange|type|trailing|full|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: tone, placeholder, value, onChange, type, trailing, full, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|ink)$/]",
        "message": "<Input> tone must be one of 'paper' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|size|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, tone, size, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|mark)$/]",
        "message": "<Logo> variant must be one of 'lockup' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Logo> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|ticks|tickTone|radius|scrim|zoomOnHover|children|style|key|ref|className|style|children)$/]",
        "message": "<MediaFrame> doesn't accept that prop. Declared props: src, alt, ratio, ticks, tickTone, radius, scrim, zoomOnHover, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute[name.name='ticks'] > Literal[value!=/^(?:top|all|none)$/]",
        "message": "<MediaFrame> ticks must be one of 'top' | 'all' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute[name.name='tickTone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<MediaFrame> tickTone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:none|bottom|left|flat)$/]",
        "message": "<MediaFrame> scrim must be one of 'none' | 'bottom' | 'left' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsletterForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|cta|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<NewsletterForm> doesn't accept that prop. Declared props: placeholder, cta, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|socials|assetBase|children|note|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: columns, socials, assetBase, children, note, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|links|active|onNavigate|compact|assetBase|trailing|style|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: tone, links, active, onNavigate, compact, assetBase, trailing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|ink)$/]",
        "message": "<SiteHeader> tone must be one of 'paper' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|body|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, label, body, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|concrete|accent|ink)$/]",
        "message": "<StatCard> tone must be one of 'paper' | 'concrete' | 'accent' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:space-between|flex-start)$/]",
        "message": "<StatCard> align must be one of 'space-between' | 'flex-start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|accent|ink)$/]",
        "message": "<Tag> variant must be one of 'outline' | 'accent' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Tag> size must be one of 'sm' | 'md'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
