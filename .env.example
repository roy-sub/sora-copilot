# SORA Copilot — environment template. Copy to .env (backend) and .env.local (frontend).
# Nothing here is a working value; every one has to be filled in from the service.

# =============================================================================
# BACKEND  — backend/.env
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Create a project in an EU region (data residency is a stated selling point), then
# Project Settings → API for the first two, and Project Settings → API → JWT Settings
# for the third. The service-role key bypasses row-level security: it is a server
# secret and must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Anthropic ----------------------------------------------------------------
# Used only by app/services/llm.py, for conversational intake and dossier prose. The
# language model never computes a determination. Leave blank to run without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Hard cap on language-model calls per organisation per month, checked before the call.
LLM_MONTHLY_CALL_CAP=500

# --- Stripe -------------------------------------------------------------------
# Optional. With no secret key nothing can be bought and the plan panel says so; with
# no webhook secret the webhook endpoint refuses every request rather than trusting an
# unverified payload. Set both or neither. See docs/THIRD_PARTY_SETUP.md.
# Developers → API keys. Use the test key until you have run a real checkout.
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → Signing secret. Starts with whsec_.
STRIPE_WEBHOOK_SECRET=
# PRICE ids (price_...), not product ids (prod_...). A plan with no price id configured
# cannot be bought, and the checkout endpoint says which variable is missing.
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_DOSSIER=
# Where Stripe returns the browser: the FRONTEND origin. Only a path is ever taken from
# a request, and it is resolved against this, so a checkout cannot redirect off-site.
STRIPE_RETURN_URL=http://localhost:3000/app/settings/

# --- Rulebase and HTTP --------------------------------------------------------
# The rulebase version determinations are pinned to. Must exist in rulebase_versions.
RULEBASE_VERSION=2.5.0-rc1
# Comma-separated. Add the deployed frontend origin for production.
CORS_ORIGINS=http://localhost:3000
# development | test | production. Production refuses to start without the Supabase keys.
ENV=development
# Injected at deploy time; surfaced by /healthz so a run can be traced to a commit.
GIT_SHA=

# =============================================================================
# FRONTEND  — frontend/.env.local
# =============================================================================

# The anon key is designed to be public and is constrained by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the backend is. Point at Render in production.
NEXT_PUBLIC_API_URL=http://localhost:8000

# A MapLibre style URL that needs no API key. Phase 4.
NEXT_PUBLIC_MAP_STYLE_URL=

# Used for metadataBase, which resolves the social-card URL at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
